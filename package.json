    "@types/node": "22.20.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.184.0",
    "@vitejs/plugin-react": "4.7.0",
    "vite": "7.3.7",
    "typescript": "5.8.3",
    "tsx": "4.23.15",
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
